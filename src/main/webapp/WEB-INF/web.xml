<?xml version="1.0" encoding="UTF-8"?>
<!--
  Deployment descriptor (Servlet 6.0 / Tomcat 10.1).
  Servlets are registered with @WebServlet annotations; filters are declared here
  because web.xml is the only portable way to guarantee filter ORDER.
-->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Net Banking Management System</display-name>

    <!-- 1st filter: UTF-8 + security headers for everything -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>controller.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2nd filter: authentication + CSRF for protected pages and APIs -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>controller.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
        <url-pattern>/deposit</url-pattern>
        <url-pattern>/withdraw</url-pattern>
        <url-pattern>/transactions</url-pattern>
        <url-pattern>/api/me</url-pattern>
        <url-pattern>/api/dashboard</url-pattern>
        <url-pattern>/api/deposit</url-pattern>
        <url-pattern>/api/withdraw</url-pattern>
        <url-pattern>/api/transactions</url-pattern>
        <url-pattern>/api/logout</url-pattern>
    </filter-mapping>

    <!-- Session: 15-minute idle timeout, HttpOnly cookie (JavaScript cannot read it), cookie-only tracking -->
    <session-config>
        <session-timeout>15</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <attribute>
                <attribute-name>SameSite</attribute-name>
                <attribute-value>Strict</attribute-value>
            </attribute>
            <!-- Enable when serving over HTTPS: <secure>true</secure> -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.html</location>
    </error-page>
</web-app>
